# 当前环境（开发）
VITE_APP_ENV=development

# API 地址（开发环境通过 Vite 代理）
VITE_API_BASE_URL=https://dummyjson.com

# 微信公众号 / 支付宝生活号 ID
VITE_APP_APPID_WEIXIN=wx169565989539bf7d
VITE_APP_APPID_ALIPAY=

# 支持环境
# - universal: 通用，支持 H5、原生嵌套 H5、微信公众号、支付宝生活号、Telegram
# - wechat: 仅支持微信
# - telegram: 仅支持 Telegram Mini App
VITE_APP_SOURCE=universal
