# 当前环境（生产）
VITE_APP_ENV=production

# API 地址
VITE_API_BASE_URL=生产环境接口地址

# 微信公众号 / 支付宝生活号 ID
VITE_APP_APPID_WEIXIN=
VITE_APP_APPID_ALIPAY=

# 基础路径（如果你的项目需部署在二级目录请填写二级目录名，如：/appName/)
VITE_APP_BASE=""

# 输出目录
VITE_OUT_DIR="dist"

# 支持环境
# - universal: 通用，支持 H5、原生嵌套 H5、微信公众号、支付宝生活号、Telegram
# - wechat: 仅支持微信
# - telegram: 仅支持 Telegram Mini App
VITE_APP_SOURCE=universal
